    };
{{ "\n" if not loop.last else "" }}{% endfor %}
}


// Database interactions


namespace {{ namespace }} {
{% for query in queries if query.is_bulk() %}
    using {{ query.struct_name }}Generator = {{ rt }}::RowGenerator<{{ query.struct_name }}Results>;
{% endfor %}
}


namespace {{ namespace }}::{{ name }} {
{% for query in queries %}
    struct ERSLIB_EXPORT {{ query.name }}_fn {
        static constexpr std::string_view label = "{{ fn.to_camel_case(name) }}/{{ fn.to_camel_case(query.name) }}";

        static {{ ret(query) }} operator()(pqxx::dbtransaction& tx{{ fn_params(query) }});
        static {{ ret(query) }} operator()(dbio::tag::transaction_t, pqxx::dbtransaction& tx{{ fn_params(query) }});


    private:
        static ers::Result<pqxx::result> _exec(pqxx::dbtransaction& tx{{ fn_params(query) }});
        static {{ ret(query) }} _process(const pqxx::result& content);
    };
    static constexpr {{ query.name }}_fn {{ query.name }};
{{ "\n\n" if not loop.last else "" }}{% endfor %}
}


