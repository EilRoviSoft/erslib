// Result structs

namespace {{ namespace }} {
{% for query in queries if query.has_result() %}
    struct ERSLIB_EXPORT {{ query.struct_name }}Results {
{% for field in query.result %}
        {{ field.class_type() }} {{ field.name }}{% if field.default %} = {{ field.default }}{% endif %};
{% endfor %}

        {{ query.struct_name }}Results() = default;
