bool {{ namespace }}::{{ fn.to_camel_case(name) }}::init(pqxx::row_ref row, const {{ fn.to_camel_case(name) }}Config& config) {
    dbio::PqxxRowStream stream(row);

{% for field in table.fields %}
    if (config[{{ fn.to_camel_case(field.name) }}] && !stream.store({{ field.name }}))
        return false;

{% endfor %}
    return true;
}


// Database interactions

{% for layout in table.layouts if layout.type %}
{{ ret(layout) }} {{ namespace }}::{{ name }}::{{ layout.name }}_fn::operator()(pqxx::dbtransaction& tx{{ fn_params(layout) }}) {
    auto r = _exec(tx{{ fn_args(layout) }});
    if (!r)
        return r.error();
    return _process(*r{% if not layout.is_bulk() %}, entity{% endif %});
}
{{ ret(layout) }} {{ namespace }}::{{ name }}::{{ layout.name }}_fn::operator()(dbio::tag::transaction_t, pqxx::dbtransaction& tx{{ fn_params(layout) }}) {
    pqxx::subtransaction subtx(tx, label);
    auto r = _exec(subtx{{ fn_args(layout) }});
    if (!r)
        return r.error();
    return _process(*r{% if not layout.is_bulk() %}, entity{% endif %});
}

ers::Result<pqxx::result> {{ namespace }}::{{ name }}::{{ layout.name }}_fn::_exec(pqxx::dbtransaction& tx{{ fn_params(layout) }}) ERS_DBIO_TRY_EVAL {
{% if layout.is_bulk() %}
    return tx.exec(dbio::queries["{{ name }}.{{ layout.name }}"]{% if layout.params %}, pqxx::params {
{% for param in layout.params %}
        {{ param.name }}{{ "," if not loop.last else "" }}
{% endfor %}
    }{% endif %});
{% else %}
{% set binds = layout['put'] + layout['condition'] if 'condition' in layout else layout['put'] %}
    return tx.exec(dbio::queries["{{ name }}.{{ layout.name }}"]{% if binds %}, pqxx::params {
{% for field in binds %}
        entity.{{ field }}{{ "," if not loop.last else "" }}
{% endfor %}
    }{% endif %});
{% endif %}
} ERS_DBIO_CATCH_EVAL_ERRORS

{% if layout.is_bulk() %}
{{ ret(layout) }} {{ namespace }}::{{ name }}::{{ layout.name }}_fn::_process(const pqxx::result& content) {
    return {{ fn.to_camel_case(name) }}Generator(content, {{ fn.to_camel_case(name) }}::{{ fn.to_camel_case(layout.name) }});
}
{% else %}
{{ ret(layout) }} {{ namespace }}::{{ name }}::{{ layout.name }}_fn::_process(const pqxx::result& content, {{ fn.to_camel_case(name) }}& entity) {
{% if fn.len(layout['get']) != 0 %}
    entity.init(content.one_row_ref(), make_config<dbio::In>({{ fn.to_camel_case(name) }}::{{ fn.to_camel_case(layout.name) }}));
{% endif %}
    return ers::ok;
}
{% endif %}
