{
    "version": 4,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_STANDARD": "26",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",

                "ERS_TRACE_VERBOSITY": "2",
                "ERS_TRACE_MAX_DEPTH": "3",
                "ERSLIB_BUILD_TESTS": "ON",
                "ERSLIB_BUILD_CONTRIB": "ON",
                "ERSLIB_BUILD_FLUX": "ON",
                "ERSLIB_BUILD_MODKIT": "ON",
                "ERSLIB_BUILD_EASY_ECS": "ON",
                "ERSLIB_BUILD_LUASCHEMA": "ON",
                "ERSLIB_BUILD_CRYPTO": "ON",
                "ERSLIB_BUILD_LOGGING": "ON",
                "ERSLIB_BUILD_WEB": "ON",

                "ERSLIB_WEB_USE_BOOST_ASIO": "ON",
                "ERSLIB_EXPOSE_GENERAL": "ON"
            }
        },
        {
            "name": "linux-base",
            "inherits": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wno-missing-field-initializers",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -O0",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG -march=x86-64-v3",

                "VCPKG_TARGET_TRIPLET": "x64-linux-app",
                "VCPKG_HOST_TRIPLET": "x64-linux-app",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
            },
            "environment": {
                "VCPKG_ROOT": "$penv{HOME}/vcpkg"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },

        {
            "name": "linux-gcc16",
            "displayName": "dbg-gcc16",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/gcc-16",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++-16"
            },
            "environment": {
                "VCPKG_APP_C_COMPILER": "/usr/bin/gcc-16",
                "VCPKG_APP_CXX_COMPILER": "/usr/bin/g++-16"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Linux" ],
                    "intelliSenseMode": "linux-gcc-x64",
                    "useCompilerDefaults": true
                },
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "copyAdditionalIncludeDirectoriesList": [
                        "/usr/include",
                        "/usr/local/include",
                        "/usr/include/x86_64-linux-gnu",
                        "/usr/include/c++/16",
                        "/usr/include/c++/16/x86_64-linux-gnu"
                    ]
                }
            }
        },
        {
            "name": "linux-gcc16.2",
            "displayName": "dbg-gcc16.2",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/opt/gcc-16.2/bin/gcc-16.2",
                "CMAKE_CXX_COMPILER": "/opt/gcc-16.2/bin/g++-16.2",
                "CMAKE_EXE_LINKER_FLAGS": "-Wl,-rpath,/opt/gcc-16.2/lib64",
                "CMAKE_SHARED_LINKER_FLAGS": "-Wl,-rpath,/opt/gcc-16.2/lib64",

                "ERSLIB_ENABLE_REFLECTION": "ON"
            },
            "environment": {
                "VCPKG_APP_C_COMPILER": "/opt/gcc-16.2/bin/gcc-16.2",
                "VCPKG_APP_CXX_COMPILER": "/opt/gcc-16.2/bin/g++-16.2"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Linux" ],
                    "intelliSenseMode": "linux-gcc-x64",
                    "useCompilerDefaults": true
                },
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "copyAdditionalIncludeDirectoriesList": [
                        "/opt/gcc-16.2/include",
                        "/opt/gcc-16.2/local/include",
                        "/opt/gcc-16.2/include/x86_64-linux-gnu",
                        "/opt/gcc-16.2/include/c++/16",
                        "/opt/gcc-16.2/include/c++/16/x86_64-linux-gnu"
                    ]
                }
            }
        },
        {
            "name": "linux-gcc16.2-asan",
            "displayName": "asan-gcc16.2",
            "inherits": "linux-gcc16.2",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize=null,nonnull-attribute,returns-nonnull-attribute -fno-sanitize-recover=undefined",
                "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wno-missing-field-initializers -fsanitize=address,undefined -fno-sanitize=null,nonnull-attribute,returns-nonnull-attribute -fno-sanitize-recover=undefined -D_GLIBCXX_ASSERTIONS",
                "CMAKE_EXE_LINKER_FLAGS": "-Wl,-rpath,/opt/gcc-16.2/lib64 -fsanitize=address,undefined",
                "CMAKE_SHARED_LINKER_FLAGS": "-Wl,-rpath,/opt/gcc-16.2/lib64 -fsanitize=address,undefined"
            }
        }
    ]
}
